# Dockerfile.sandbox
# Isolated Execution Sandbox for Python, Java, and C++

FROM ubuntu:22.04

# Prevent interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install runtimes & compilers
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    openjdk-17-jdk-headless \
    g++ \
    gcc \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root sandbox user for security
RUN useradd -m -s /bin/bash sandboxuser

WORKDIR /sandbox

# Set permissions
RUN chown -R sandboxuser:sandboxuser /sandbox

USER sandboxuser

# Default command keeps container open if invoked interactively or serves as baseline
CMD ["/bin/bash"]

# OptiCode Environment Configuration Example

# FastAPI Settings
PROJECT_NAME="Big-O Optimization Checker Backend"
VERSION="1.0.0"
API_PREFIX="/api/v1"

# Security & Credentials (Override for production)
DEMO_USER_PASSWORD="opticode2024"
DEMO_ADMIN_PASSWORD="admin123"

# Execution Sandbox Configuration
SANDBOX_DOCKER_IMAGE="bigo-sandbox:latest"
SANDBOX_TIMEOUT_SECONDS=5.0
SANDBOX_MEMORY_LIMIT="128m"
SANDBOX_NCPU=1.0
MAX_CODE_LENGTH=20000

# Execution Fallback
ALLOW_LOCAL_FALLBACK=true
